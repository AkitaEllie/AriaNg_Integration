{
	"manifest_version": 2,
	"name": "AriaNG_Integration",
	"description": "Replaces your downloader and download manager with aria2c (not included) and ariaNG",
	"version": "0.0.1",
	"icons": {
		"64": "icons/icon.png"
	},
	"browser_action": {
		"default_title": "AriaNG Integration",
		"default_icon": {
			"64": "icons/icon.png"
		}
		,"default_popup": "popup.html"
	},
	"permissions": [
		"storage",
		"tabs",
		"notifications",
		"webRequest",
		"webRequestBlocking",
		"cookies",
		"<all_urls>"
	],
	"background": {
		"scripts": [
			"background_script.js"
		]
	},
	"options_ui": {
		"page": "options/index.html",
		"open_in_tab": true
	}
}